[
  {
    "name": "theme_info",
    "theme_name": "Sploot",
    "theme_author": "Sploot & Co",
    "theme_version": "1.0.0",
    "theme_documentation_url": "https://github.com/jcsimon2030-cmd/splootandco",
    "theme_support_url": "mailto:jcsimon2030@gmail.com"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 240,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 120
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon (32x32 PNG)"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      { "type": "color", "id": "color_bg", "label": "Background", "default": "#0B0B0B" },
      { "type": "color", "id": "color_fg", "label": "Foreground / text", "default": "#F4EFE6" },
      { "type": "color", "id": "color_accent", "label": "Accent (buttons, hover)", "default": "#B5471A" },
      { "type": "color", "id": "color_muted", "label": "Muted text", "default": "#8C8275" },
      { "type": "color", "id": "color_line", "label": "Lines / borders", "default": "#2A2A2A" },
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          { "type": "color", "id": "background", "label": "Background", "default": "#0B0B0B" },
          { "type": "color_background", "id": "background_gradient", "label": "Background gradient" },
          { "type": "color", "id": "text", "label": "Text", "default": "#F4EFE6" },
          { "type": "color", "id": "button", "label": "Button", "default": "#F4EFE6" },
          { "type": "color", "id": "button_label", "label": "Button label", "default": "#0B0B0B" },
          { "type": "color", "id": "secondary_button_label", "label": "Secondary button label", "default": "#F4EFE6" },
          { "type": "color", "id": "shadow", "label": "Shadow", "default": "#000000" }
        ],
        "role": {
          "text": "text",
          "background": { "solid": "background", "gradient": "background_gradient" },
          "links": "text",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "secondary_button_label",
          "secondary_button_border": "secondary_button_label"
        }
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "assistant_n4",
        "label": "Body font"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "archivo_n9",
        "label": "Heading / display font"
      },
      {
        "type": "checkbox",
        "id": "headings_uppercase",
        "default": true,
        "label": "Uppercase headings"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "container_width",
        "min": 1200,
        "max": 1800,
        "step": 40,
        "unit": "px",
        "label": "Max container width",
        "default": 1440
      },
      {
        "type": "select",
        "id": "card_style",
        "label": "Product card style",
        "options": [
          { "value": "edge",   "label": "Edge — flush image, info below" },
          { "value": "framed", "label": "Framed — bordered card" }
        ],
        "default": "edge"
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      { "type": "url", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "url", "id": "social_tiktok",    "label": "TikTok URL" },
      { "type": "url", "id": "social_twitter",   "label": "X / Twitter URL" },
      { "type": "url", "id": "social_youtube",   "label": "YouTube URL" }
    ]
  }
]
