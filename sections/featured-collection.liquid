{%- liquid
  assign coll = collections[section.settings.collection]
  assign cols = section.settings.cols | default: '4'
  assign limit = section.settings.limit | default: 8
-%}
<section class="featured" data-section-id="{{ section.id }}">
  <div class="container">
    <header class="sect-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="sect-h">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
      {%- if coll.url != blank -%}
        <a href="{{ coll.url }}" class="sect-link">{{ section.settings.cta_label | default: 'View all →' }}</a>
      {%- endif -%}
    </header>

    {%- if coll.products.size > 0 -%}
      <div class="pgrid pgrid-{{ cols }}">
        {%- for product in coll.products limit: limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="sect-blurb">{{ 'collections.general.no_matches' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "NEWLY FORGED" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the armory" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "select", "id": "cols", "label": "Columns (desktop)",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ], "default": "4" },
    { "type": "text", "id": "cta_label", "label": "Link label", "default": "View all →" }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
