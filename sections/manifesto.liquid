<section class="manifesto-block" data-section-id="{{ section.id }}">
  <div class="container">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow" style="color:var(--ash)">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <p class="manifesto-body">{{ section.settings.body }}</p>
    {%- if section.settings.signature != blank -%}
      <p class="meta" style="color:var(--ash)">— {{ section.settings.signature }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Manifesto",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE CREDO" },
    { "type": "richtext", "id": "body", "label": "Body",
      "default": "<p>The internet wants you to be a lone wolf. The internet is a sales funnel. We are the pack. Stay soft. Stay feral. Wear the armor.</p>" },
    { "type": "text", "id": "signature", "label": "Signature", "default": "SPLOOT & CO" }
  ],
  "presets": [{ "name": "Manifesto" }]
}
{% endschema %}
