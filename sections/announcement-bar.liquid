<div class="announcement-bar" data-section-id="{{ section.id }}">
  <div class="announcement-bar__track">
    {%- for block in section.blocks -%}
      <span class="announcement-bar__item" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
        {%- else -%}
          {{ block.settings.text }}
        {%- endif -%}
      </span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 5,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping over $100" },
        { "type": "url",  "id": "link", "label": "Link" }
      ]
    }
  ]
}
{% endschema %}
