<section class="newsletter" data-section-id="{{ section.id }}">
  <div class="container newsletter__inner">
    <div class="newsletter__copy">
      <h2 class="newsletter__heading">{{ section.settings.heading }}</h2>
      <p class="newsletter__sub">{{ section.settings.subheading }}</p>
    </div>
    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label for="NewsletterEmail" class="visually-hidden">{{ 'general.newsletter.label' | t }}</label>
      <input
        type="email"
        id="NewsletterEmail"
        name="contact[email]"
        placeholder="{{ 'general.newsletter.placeholder' | t }}"
        autocomplete="email"
        required>
      <button type="submit" class="btn btn--solid">{{ 'general.newsletter.submit' | t }}</button>
      {%- if form.posted_successfully? -%}
        <p class="newsletter__success">{{ 'general.newsletter.success' | t }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading",    "label": "Heading",    "default": "Join the pack" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "First looks, drops, and packwide signal. No spam." }
  ]
}
{% endschema %}
