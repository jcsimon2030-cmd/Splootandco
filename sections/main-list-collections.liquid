<main class="col-strip" data-section-id="{{ section.id }}">
  <div class="container">
    <header class="sect-head">
      <div>
        <p class="eyebrow">BROWSE</p>
        <h1 class="sect-h">The Armory</h1>
      </div>
      <p class="sect-note">Every family. Same pack.</p>
    </header>

    <div class="col-grid">
      {%- for col in collections -%}
        {%- unless col.handle == 'frontpage' -%}
          {%- assign img = col.image | default: col.featured_image -%}
          <a href="{{ col.url }}" class="col-tile">
            <div class="photo photo-coal">
              {%- if img -%}
                <img src="{{ img | image_url: width: 1000 }}" alt="{{ img.alt | escape | default: col.title }}" loading="lazy">
              {%- endif -%}
            </div>
            <div class="col-tile-caption">
              <div><h3 class="col-tile-h">{{ col.title }}</h3></div>
              <p class="col-tile-count">{{ col.all_products_count }} pieces</p>
            </div>
          </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</main>

{% schema %}
{ "name": "List collections" }
{% endschema %}
