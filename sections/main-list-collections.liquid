<section class="collections-index" data-section-id="{{ section.id }}">
  <div class="container">
    <header class="section-head">
      <p class="section-head__eyebrow">All</p>
      <h1 class="section-head__title">Collections</h1>
    </header>

    <div class="collection-list__grid">
      {%- for col in collections -%}
        {%- if col.handle != 'frontpage' -%}
          <a href="{{ col.url }}" class="collection-tile">
            <div class="collection-tile__media">
              {%- if col.image -%}
                <img src="{{ col.image | image_url: width: 900 }}" alt="{{ col.title }}" width="900" height="1200" loading="lazy">
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <div class="collection-tile__caption">
              <h3 class="collection-tile__title">{{ col.title }}</h3>
              <span class="collection-tile__count">{{ col.products_count }} items</span>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "List collections"
}
{% endschema %}
