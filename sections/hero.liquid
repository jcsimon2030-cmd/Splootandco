<section
  class="hero hero--{{ section.settings.height }} hero--align-{{ section.settings.text_align }}"
  data-section-id="{{ section.id }}"
  {% if section.settings.bg_image %}style="background-image:url('{{ section.settings.bg_image | image_url: width: 2400 }}');"{% endif %}>

  <div class="hero__scrim"></div>

  <div class="container hero__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="hero__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
      <a href="{{ section.settings.cta_link }}" class="btn btn--solid hero__cta">
        {{ section.settings.cta_label }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "bg_image",    "label": "Background image" },
    { "type": "text",         "id": "eyebrow",     "label": "Eyebrow", "default": "Drop 01" },
    { "type": "text",         "id": "heading",     "label": "Heading", "default": "We are the pack." },
    { "type": "textarea",     "id": "subheading",  "label": "Subheading", "default": "Heavy armor for soft hearts. Built for the days you need to be feral and tender in the same breath." },
    { "type": "text",         "id": "cta_label",   "label": "Button label", "default": "Enter the armory" },
    { "type": "url",          "id": "cta_link",    "label": "Button link" },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "short",  "label": "Short" },
        { "value": "medium", "label": "Medium" },
        { "value": "tall",   "label": "Tall" },
        { "value": "full",   "label": "Full viewport" }
      ],
      "default": "tall"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    }
  ],
  "presets": [
    { "name": "Hero" }
  ]
}
{% endschema %}
