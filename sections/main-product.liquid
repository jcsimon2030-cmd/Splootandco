{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured = current_variant.featured_media | default: product.featured_media
  assign crumb_col = collection | default: product.collections.first
  assign vendor_line = product.type | default: product.vendor
-%}

<main class="pdp" data-section-id="{{ section.id }}" data-product-id="{{ product.id }}">
  <nav class="pdp-crumb container" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span>/</span>
    {%- if crumb_col -%}
      <a href="{{ crumb_col.url }}">{{ crumb_col.title }}</a>
      <span>/</span>
    {%- endif -%}
    <span class="is-current">{{ product.title }}</span>
  </nav>

  <div class="pdp-grid container">
    <div class="pdp-gallery">
      <div class="pdp-main">
        {%- if featured -%}
          <img data-pdp-main
               src="{{ featured | image_url: width: 1400 }}"
               srcset="{{ featured | image_url: width: 700 }} 700w, {{ featured | image_url: width: 1100 }} 1100w, {{ featured | image_url: width: 1600 }} 1600w"
               sizes="(min-width: 990px) 55vw, 100vw"
               alt="{{ featured.alt | escape | default: product.title }}"
               width="{{ featured.width }}" height="{{ featured.height }}" loading="eager">
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="pdp-thumbs">
          {%- for media in product.media -%}
            <button type="button" class="pdp-thumb{% if media.id == featured.id %} is-active{% endif %}"
                    data-pdp-thumb data-full="{{ media | image_url: width: 1400 }}"
                    data-media-id="{{ media.id }}" aria-label="View image {{ forloop.index }}">
              <img src="{{ media | image_url: width: 200 }}" alt="" width="88" height="88" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <aside class="pdp-info">
      {%- if vendor_line != blank -%}<p class="pdp-vendor">{{ vendor_line }}</p>{%- endif -%}
      <h1 class="pdp-title">{{ product.title }}</h1>
      <div class="pdp-price" data-pdp-price>{% render 'price', product: product, use_variant: true %}</div>

      {%- if product.description != blank -%}
        <div class="pdp-blurb rte">{{ product.description }}</div>
      {%- endif -%}

      <product-form>
        {%- form 'product', product, id: 'ProductForm', class: 'pdp-product-form' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              {%- liquid
                assign oname = option.name | downcase
                if oname contains 'size'
                  assign ocls = 'size'
                  assign wrapcls = 'pdp-sizes'
                else
                  assign ocls = 'swatch'
                  assign wrapcls = 'pdp-swatches'
                endif
              -%}
              <fieldset class="pdp-opt" data-option-index="{{ forloop.index0 }}">
                <legend>{{ option.name }} · <strong data-opt-selected>{{ option.selected_value }}</strong></legend>
                <div class="{{ wrapcls }}">
                  {%- for value in option.values -%}
                    {%- assign rid = 'o-' | append: section.id | append: '-' | append: forloop.parentloop.index0 | append: '-' | append: forloop.index0 -%}
                    <input type="radio" class="visually-hidden" id="{{ rid }}"
                           name="options[{{ option.name | escape }}]" value="{{ value | escape }}"
                           {% if option.selected_value == value %}checked{% endif %}>
                    <label for="{{ rid }}" class="{{ ocls }}">{{ value }}</label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
          {%- endunless -%}

          <div class="pdp-buy">
            <div class="qty">
              <button type="button" data-qty-down aria-label="Decrease quantity">−</button>
              <input type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="{{ 'accessibility.quantity' | t }}" data-qty-input>
              <button type="button" data-qty-up aria-label="Increase quantity">+</button>
            </div>
            <button type="submit" name="add" class="btn btn-fill btn-block" data-add-btn {% unless current_variant.available %}disabled{% endunless %}>
              <span data-add-label>{% if current_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
            </button>
          </div>
          <p class="pdp-form-error" data-form-error hidden></p>
        {%- endform -%}
      </product-form>

      {%- if section.settings.trust_1 != blank or section.settings.trust_2 != blank or section.settings.trust_3 != blank -%}
        <ul class="pdp-trust">
          {%- if section.settings.trust_1 != blank -%}<li>{{ section.settings.trust_1 }}</li>{%- endif -%}
          {%- if section.settings.trust_2 != blank -%}<li>{{ section.settings.trust_2 }}</li>{%- endif -%}
          {%- if section.settings.trust_3 != blank -%}<li>{{ section.settings.trust_3 }}</li>{%- endif -%}
        </ul>
      {%- endif -%}

      <div class="pdp-tabs" data-tabs>
        <div class="pdp-tab-heads">
          <button type="button" class="is-on" data-tab="details">Details</button>
          {%- if section.settings.fabric_text != blank -%}<button type="button" data-tab="fabric">Fabric &amp; Care</button>{%- endif -%}
          {%- if section.settings.shipping_text != blank -%}<button type="button" data-tab="shipping">Shipping &amp; Returns</button>{%- endif -%}
        </div>
        <div class="pdp-tab-body">
          <div data-tab-panel="details" class="rte">
            {%- if section.settings.details_text != blank -%}{{ section.settings.details_text }}{%- else -%}{{ product.description }}{%- endif -%}
          </div>
          {%- if section.settings.fabric_text != blank -%}
            <div data-tab-panel="fabric" class="rte" hidden>{{ section.settings.fabric_text }}</div>
          {%- endif -%}
          {%- if section.settings.shipping_text != blank -%}
            <div data-tab-panel="shipping" class="rte" hidden>{{ section.settings.shipping_text }}</div>
          {%- endif -%}
        </div>
      </div>
    </aside>
  </div>
</main>

<script type="application/json" data-product-json>{{ product | json }}</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "header", "content": "Trust badges" },
    { "type": "text", "id": "trust_1", "label": "Badge 1", "default": "↻ Free packwide shipping over $120" },
    { "type": "text", "id": "trust_2", "label": "Badge 2", "default": "↺ Free returns within 30 days" },
    { "type": "text", "id": "trust_3", "label": "Badge 3", "default": "✦ Printed & sewn to order" },
    { "type": "header", "content": "Tabs" },
    { "type": "richtext", "id": "details_text", "label": "Details tab", "info": "Leave blank to use the product description." },
    { "type": "richtext", "id": "fabric_text", "label": "Fabric & Care tab",
      "default": "<p>Heavyweight ringspun cotton. Cold wash, inside out. Hang dry. The graphic is meant to fade with you — that's the point.</p>" },
    { "type": "richtext", "id": "shipping_text", "label": "Shipping & Returns tab",
      "default": "<p>Printed to order. Production takes about 2 business days, then tracked shipping — roughly 7–12 business days in the US. Free returns within 30 days on stock items.</p>" }
  ]
}
{% endschema %}
