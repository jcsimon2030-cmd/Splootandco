<section class="not-found" data-section-id="{{ section.id }}">
  <div class="container container--narrow not-found__inner">
    <p class="not-found__code">404</p>
    <h1 class="not-found__title">{{ 'general.404.title' | t }}</h1>
    <p class="not-found__sub">{{ 'general.404.subtitle' | t }}</p>
    <a href="{{ routes.collections_url }}" class="btn btn--solid">{{ 'general.404.link' | t }}</a>
  </div>
</section>

{% schema %}
{
  "name": "404"
}
{% endschema %}
