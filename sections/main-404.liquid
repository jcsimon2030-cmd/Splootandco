<main class="notfound" data-section-id="{{ section.id }}">
  <div class="container">
    <p class="notfound-code">404</p>
    <h1 class="notfound-h">{{ 'general.404.title' | t }}</h1>
    <p class="notfound-p">{{ 'general.404.subtitle' | t }}</p>
    <a href="{{ routes.root_url }}" class="btn btn-fill">{{ 'general.404.link' | t }}</a>
  </div>
</main>

{% schema %}
{ "name": "404" }
{% endschema %}
