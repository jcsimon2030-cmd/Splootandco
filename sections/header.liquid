<site-header class="hdr" data-section-id="{{ section.id }}">
  <div class="hdr-inner">
    <div class="hdr-left">
      <button type="button" class="hdr-icon hdr-menu" data-menu-open aria-label="{{ 'accessibility.menu' | t }}" aria-expanded="false">
        {% render 'icon', name: 'menu', size: 22 %}
      </button>
      <nav class="hdr-nav" aria-label="Primary">
        {%- for link in linklists[section.settings.menu].links -%}
          <a href="{{ link.url }}" class="hdr-link{% if link.current or link.child_active %} is-active{% endif %}">{{ link.title }}</a>
        {%- endfor -%}
      </nav>
    </div>

    <a class="hdr-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {%- if settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 360 }}" alt="{{ shop.name | escape }}"
             width="180" height="44" loading="eager">
      {%- else -%}
        {% render 'wordmark', ws: 22 %}
      {%- endif -%}
    </a>

    <div class="hdr-actions">
      <a class="hdr-icon" href="{{ routes.search_url }}" aria-label="{{ 'accessibility.search' | t }}">
        {% render 'icon', name: 'search', size: 18 %}
      </a>
      <a class="hdr-icon" href="{{ routes.account_url | default: '/account' }}" aria-label="Account">
        {% render 'icon', name: 'account', size: 18 %}
      </a>
      <a class="hdr-icon hdr-cart" href="{{ routes.cart_url }}" data-cart-open aria-label="{{ 'accessibility.cart' | t }}">
        {% render 'icon', name: 'bag', size: 18 %}
        {%- if cart.item_count > 0 -%}
          <span class="hdr-cart-count" data-cart-count>{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </div>

  <div class="mobile-nav" data-mobile-nav>
    <div class="mobile-nav-head">
      {% render 'wordmark', ws: 22 %}
      <button type="button" class="hdr-icon" data-menu-close aria-label="{{ 'accessibility.close' | t }}">
        {% render 'icon', name: 'close', size: 22 %}
      </button>
    </div>
    {%- for link in linklists[section.settings.menu].links -%}
      <a href="{{ link.url }}" class="mobile-nav-link">{{ link.title }}</a>
    {%- endfor -%}
  </div>
  <div class="scrim" data-menu-scrim></div>
</site-header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "default": "main-menu", "label": "Menu" }
  ]
}
{% endschema %}
