<main class="collection-page" data-section-id="{{ section.id }}">
  <header class="col-head">
    <div class="container">
      <p class="eyebrow col-eyebrow">{{ collection.metafields.custom.eyebrow | default: section.settings.eyebrow }}</p>
      <h1 class="col-title">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="col-desc rte">{{ collection.description }}</div>
      {%- endif -%}
    </div>
  </header>

  {%- paginate collection.products by 24 -%}
    <form method="get" data-facet-form>
      <div class="container col-toolbar">
        {%- if collection.filters.size > 0 -%}
          {%- assign active_count = 0 -%}
          {%- for f in collection.filters -%}
            {%- for v in f.active_values -%}{%- assign active_count = active_count | plus: 1 -%}{%- endfor -%}
            {%- if f.min_value.value or f.max_value.value -%}{%- assign active_count = active_count | plus: 1 -%}{%- endif -%}
          {%- endfor -%}
          <button type="button" class="filter-btn" data-filter-toggle aria-expanded="false">
            &#9638; Filter{% if active_count > 0 %} <span class="filter-count">({{ active_count }})</span>{% endif %}
          </button>
        {%- else -%}
          <span></span>
        {%- endif -%}

        <span class="meta">{{ collection.products_count }} {% if collection.products_count == 1 %}piece{% else %}pieces{% endif %}</span>

        {%- if collection.sort_options.size > 0 -%}
          {%- assign sort = collection.sort_by | default: collection.default_sort_by -%}
          <select class="sort-select" name="sort_by" data-auto-submit aria-label="{{ 'products.facets.sort_by' | t }}">
            {%- for o in collection.sort_options -%}
              <option value="{{ o.value }}"{% if o.value == sort %} selected{% endif %}>{{ o.name }}</option>
            {%- endfor -%}
          </select>
        {%- else -%}
          <span></span>
        {%- endif -%}
      </div>

      <div class="col-layout container" data-col-layout>
        {%- if collection.filters.size > 0 -%}
          <aside class="filters" data-filters hidden>
            {%- for filter in collection.filters -%}
              <details class="filter-group" open>
                <summary>{{ filter.label }} <span class="plus">+</span></summary>
                {%- case filter.type -%}
                  {%- when 'price_range' -%}
                    <div class="filter-values" style="flex-direction:row;gap:8px">
                      <input type="number" class="promo-input" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value }}" placeholder="Min" min="0" data-auto-submit style="width:100%">
                      <input type="number" class="promo-input" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value }}" placeholder="Max" min="0" data-auto-submit style="width:100%">
                    </div>
                  {%- else -%}
                    <div class="filter-values">
                      {%- for value in filter.values -%}
                        <label class="filter-value">
                          <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"
                            {% if value.active %}checked{% endif %}
                            {% if value.count == 0 and value.active == false %}disabled{% endif %} data-auto-submit>
                          <span>{{ value.label }}{% if value.count > 0 %} <small style="color:var(--grit)">({{ value.count }})</small>{% endif %}</span>
                        </label>
                      {%- endfor -%}
                    </div>
                {%- endcase -%}
              </details>
            {%- endfor -%}
            <a href="{{ collection.url }}" class="filters-clear">Clear all</a>
          </aside>
        {%- endif -%}

        <div data-pgrid>
          {%- if collection.products.size > 0 -%}
            <div class="pgrid pgrid-4">
              {%- for product in collection.products -%}
                {% render 'product-card', product: product, collection: collection %}
              {%- endfor -%}
            </div>
            {%- if paginate.pages > 1 -%}
              <nav class="pagination" aria-label="Pagination">
                {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">←</a>{%- endif -%}
                {%- for part in paginate.parts -%}
                  {%- if part.is_link -%}
                    <a href="{{ part.url }}">{{ part.title }}</a>
                  {%- else -%}
                    <span{% if part.title == paginate.current_page %} class="is-current"{% endif %}>{{ part.title }}</span>
                  {%- endif -%}
                {%- endfor -%}
                {%- if paginate.next -%}<a href="{{ paginate.next.url }}">→</a>{%- endif -%}
              </nav>
            {%- endif -%}
          {%- else -%}
            <p class="sect-blurb" style="padding:64px 0">{{ 'collections.general.no_matches' | t }}</p>
          {%- endif -%}
        </div>
      </div>
    </form>
  {%- endpaginate -%}
</main>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Default eyebrow", "default": "THE ARMORY",
      "info": "Override per collection with a custom.eyebrow metafield." }
  ]
}
{% endschema %}
