{%- comment -%}
  Hover-swap product card — woodcut/brutalist.
  Usage: {% render 'product-card', product: product, collection: collection %}
{%- endcomment -%}
{%- liquid
  assign p = product
  assign img_a = p.featured_media
  assign img_b = nil
  for m in p.media
    unless forloop.first
      assign img_b = m
      break
    endunless
  endfor
  assign var = p.selected_or_first_available_variant
  assign on_sale = false
  if var.compare_at_price > var.price
    assign on_sale = true
  endif
-%}
<a href="{{ p.url | within: collection }}" class="pcard" data-product-card>
  <div class="pcard-media">
    <div class="pcard-photo-a">
      {%- if img_a -%}
        <img src="{{ img_a | image_url: width: 720 }}"
             srcset="{{ img_a | image_url: width: 360 }} 360w, {{ img_a | image_url: width: 720 }} 720w, {{ img_a | image_url: width: 1080 }} 1080w"
             sizes="(min-width: 1100px) 25vw, (min-width: 750px) 33vw, 50vw"
             alt="{{ img_a.alt | escape | default: p.title }}"
             width="{{ img_a.width }}" height="{{ img_a.height }}" loading="lazy">
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    {%- if img_b -%}
      <div class="pcard-photo-b">
        <img src="{{ img_b | image_url: width: 720 }}" alt="{{ img_b.alt | escape | default: p.title }}" loading="lazy">
      </div>
    {%- endif -%}

    {%- if p.available == false -%}
      <span class="pcard-badge" style="background:var(--line);color:var(--ash)">SOLD OUT</span>
    {%- elsif p.tags contains 'New' or p.tags contains 'new' -%}
      <span class="pcard-badge">NEW</span>
    {%- elsif on_sale -%}
      <span class="pcard-badge">ON SALE</span>
    {%- elsif p.tags contains 'Limited' or p.tags contains 'limited' -%}
      <span class="pcard-badge">LIMITED</span>
    {%- endif -%}

    <button type="button" class="pcard-qv" data-quick-view data-product-handle="{{ p.handle }}">Quick View</button>
  </div>

  <div class="pcard-info">
    <div>
      {%- if p.type != blank -%}
        <p class="pcard-tag">{{ p.type }}</p>
      {%- else -%}
        <p class="pcard-tag">{{ p.vendor }}</p>
      {%- endif -%}
      <h4 class="pcard-name">{{ p.title | escape }}</h4>
    </div>
    {% render 'price', product: p, use_variant: true, show_from: true %}
  </div>

  {%- for opt in p.options_with_values -%}
    {%- assign d = opt.name | downcase -%}
    {%- if d == 'color' or d == 'colour' -%}
      <div class="pcard-colors">
        {%- for v in opt.values limit: 4 -%}<span class="pcard-color">{{ v }}</span>{%- endfor -%}
        {%- if opt.values.size > 4 -%}<span class="pcard-color">+{{ opt.values.size | minus: 4 }}</span>{%- endif -%}
      </div>
    {%- endif -%}
  {%- endfor -%}
</a>
