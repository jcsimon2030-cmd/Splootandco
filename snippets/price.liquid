{%- liquid
  if use_variant and product.selected_or_first_available_variant
    assign target = product.selected_or_first_available_variant
  elsif variant
    assign target = variant
  elsif product
    assign target = product
  endif
  assign price = target.price | default: product.price | default: 0
  assign compare = target.compare_at_price
  assign on_sale = false
  if compare and compare > price
    assign on_sale = true
  endif
-%}
<span class="price{% if on_sale %} price--sale{% endif %}">
  {%- if product.price_varies and show_from -%}<span class="price-from">From</span>{%- endif -%}
  <span class="price-now">{{ price | money }}</span>
  {%- if on_sale -%}<s class="price-was">{{ compare | money }}</s>{%- endif -%}
</span>
